@{
    ViewData["Title"] = "Login";
}

<section class="page-section" id="login" style="padding-top: 7rem; padding-bottom: 5rem;">
    <div class="container px-4 px-lg-5">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-9">
                <div class="row g-0 rounded shadow-lg overflow-hidden">

                    <!-- Brand panel -->
                    <div class="col-md-5 bg-primary text-white d-flex flex-column justify-content-center align-items-center text-center p-5">
                        <div class="divider-custom divider-light mb-4">
                            <div class="divider-custom-line"></div>
                            <div class="divider-custom-icon"><i class="fas fa-star"></i></div>
                            <div class="divider-custom-line"></div>
                        </div>
                        <h2 class="text-uppercase text-white mb-3">Welcome Back</h2>
                        <p class="text-white-50 mb-0">Log in to pick up right where you left off.</p>
                    </div>

                    <!-- Form panel -->
                    <div class="col-md-7 bg-white p-5">
                        <h2 class="page-section-heading text-uppercase text-secondary mb-1">Login</h2>
                        <p class="text-muted mb-4">Enter your credentials to continue.</p>

                        <form id="loginForm">
                            <div class="form-floating mb-3">
                                <input class="form-control" id="email" name="email" type="email" placeholder="Enter your email..." required />
                                <label for="email">Email address</label>
                            </div>
                            <div class="form-floating mb-4">
                                <input class="form-control" id="password" name="password" type="password" placeholder="Enter your password..." required />
                                <label for="password">Password</label>
                            </div>
                            <button class="btn btn-primary btn-xl w-100" type="submit">Log In</button>
                        </form>

                        <p class="text-center mt-4 mb-0">
                            Don't have an account?
                            <a asp-controller="Home" asp-action="Register" class="fw-bold text-primary">Register</a>
                        </p>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#loginForm').on('submit', function (e) {
                e.preventDefault();

                var formData = {
                    email: $('#email').val(),
                    password: $('#password').val()
                };

                $.ajax({
                    url: '@Url.Action("Login", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                            success: function (response) {
            if (response.error) {
                alert('Database error: ' + response.error);
                return;
            }
            if (response.success) {
                window.location.href = '@Url.Action("Dashboard", "Home")';
            } else {
                alert(response.message || 'Login failed.');
            }
        },
                    error: function (xhr) {
                        alert('Something went wrong. Status: ' + xhr.status);
                    }
                });
            });
        });
    </script>
}
